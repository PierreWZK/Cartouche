# Modèle des variables de l'API, lu par Node au démarrage (config.ts). Copier en .env en local, ou saisir dans Coolify.
# Aucune valeur réelle ici : ne jamais committer un vrai .env. Ta consigne : « On continue jusqu'à la fin ».
PORT=3000
CORS_ORIGIN=https://cartouche.projectp.fr
RAWG_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
DATABASE_URL=postgres://utilisateur:motdepasse@hote:5432/cartouche
