{
  "name": "cartouche-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev:memory": "tsc -p tsconfig.json && node --env-file-if-exists=.env dist/dev/memory-server.js",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "typescript": "^5.9.3"
  }
}
